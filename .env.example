OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL_NAME=
# Copy to .env; set a function-calling capable model available to your account.
MODEL_TIMEOUT_SECONDS=45
MODEL_PROVIDER=openai-compatible
# MiniMax: MODEL_NAME=MiniMax-M3.1-Flash; MODEL_PROVIDER=minimax
# OPENAI_BASE_URL=https://api.minimax.cn/v1 (China) or https://api.minimax.io/v1
# MODEL_REASONING_EFFORT=low; MODEL_JSON_MODE=off
# MODEL_MIN_INTERVAL_SECONDS=2
